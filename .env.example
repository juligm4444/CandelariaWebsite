# =============================================================================
# Candelaria Solar Car - environment
#
# Copy to .env.local for development. In production these live in the Vercel
# project settings, never in the repository.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and must
# never hold a secret. Everything else is server-only and is validated by
# lib/env.ts before it is used.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# Public origin, no trailing slash. Used for auth callbacks and e-mail links.
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (database + storage)
# -----------------------------------------------------------------------------
# Pooled connection string from Supabase: Project settings > Database >
# Connection string > Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Supabase CA certificate (PEM). Required in production: the pooler is signed by
# Supabase's own CA. Project Settings > Database > SSL Configuration. Newlines
# may be written as literal \n if your host needs a single line.
DATABASE_CA_CERT=

# Project URL. Not a credential: it is used to build public storage URLs.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co

# Service role key. SECRET. Used only for storage writes from the server.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# -----------------------------------------------------------------------------
# better-auth
# -----------------------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Comma-separated e-mail domains an area lead can invite as an internal
# account. Having this domain does NOT by itself grant internal status: only
# a lead's invite does. Example: uniandes.edu.co
INTERNAL_EMAIL_DOMAINS=uniandes.edu.co

# -----------------------------------------------------------------------------
# Polar.sh (payments)
# -----------------------------------------------------------------------------
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# sandbox while testing, production once the organisation is live
POLAR_SERVER=sandbox

# Product ids from the Polar dashboard, one per membership tier. Polar's
# acceptable-use policy prohibits donations as a product category outright,
# so there is no donation product here anymore.
POLAR_PRODUCT_COBRE=
POLAR_PRODUCT_ALUMINIO=
POLAR_PRODUCT_TITANIO=

# -----------------------------------------------------------------------------
# Resend (transactional e-mail)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=Candelaria Solar Car <no-reply@candelaria.website>
# Inbox that receives the contact form.
CONTACT_INBOX=

# -----------------------------------------------------------------------------
# PostHog (analytics)
# -----------------------------------------------------------------------------
# Project API key. Public by design: it can write events, never read them.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional separate key for server-side capture. Falls back to the public one.
POSTHOG_API_KEY=
